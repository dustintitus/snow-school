{
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "env": {
    "FLASK_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "* * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "release/production-baseline-2026-11-02": false,
      "feature/program-supervisors-schema-only": false
    }
  }
}
